@model HospiVital.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="login-page">
    <div class="login-left">
        <div class="login-brand">
            <div class="login-brand-icon">+</div>
            <h1>HOSPI-VITAL</h1>
            <p>SISTEMA DE GESTIÓN BANCO DE SANGRE</p>
        </div>
    </div>

    <div class="login-right">
        <div class="login-card">
            <h2 class="login-title">Bienvenido de nuevo</h2>
            <p class="login-subtitle">
                Por favor, ingrese sus credenciales para acceder al sistema
            </p>

            <form asp-action="Login" asp-controller="Home" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="login-form-group">
                    <label asp-for="Usuario"></label>
                    <div class="login-input-wrap">
                        <span class="login-input-icon">👤</span>
                        <input asp-for="Usuario" class="login-control" placeholder="Ej: juan.perez" />
                    </div>
                    <span asp-validation-for="Usuario" class="text-danger"></span>
                </div>

                <div class="login-form-group">
                    <label asp-for="Contrasena"></label>
                    <div class="login-input-wrap">
                        <span class="login-input-icon">🔒</span>
                        <input asp-for="Contrasena" class="login-control" placeholder="********" />
                    </div>
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>

                <button type="submit" class="login-submit">INGRESAR</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}