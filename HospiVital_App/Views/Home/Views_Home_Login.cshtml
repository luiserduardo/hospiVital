@model HospiVital_App.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesion - HOSPI-VITAL";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --color-carmesi: #DC143C;
            --color-carmesi-hover: #B01030;
            --color-carmesi-light: rgba(220, 20, 60, 0.1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        .login-container {
            display: flex;
            min-height: 100vh;
        }

        .branding-column {
            flex: 0 0 50%;
            background-color: var(--color-carmesi);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        .logo-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .logo-icon {
            width: 120px;
            height: 120px;
            border: 4px solid rgba(255, 255, 255, 0.9);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 2rem;
        }

        .logo-icon i {
            font-size: 60px;
            color: white;
            font-weight: bold;
        }

        .brand-name {
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            letter-spacing: 2px;
            margin-bottom: 1rem;
        }

        .brand-separator {
            width: 80px;
            height: 2px;
            background-color: rgba(255, 255, 255, 0.7);
            margin: 0 auto 1rem auto;
        }

        .brand-subtitle {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.9);
            letter-spacing: 3px;
            text-transform: uppercase;
            text-align: center;
            line-height: 1.6;
        }

        .form-column {
            flex: 0 0 50%;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem 4rem;
        }

        .form-container {
            width: 100%;
            max-width: 400px;
        }

        .form-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .form-subtitle {
            font-size: 0.95rem;
            color: #6c757d;
            margin-bottom: 2.5rem;
            text-align: center;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-weight: 500;
            color: #333;
            margin-bottom: 0.5rem;
            display: block;
        }

        .input-group {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
            font-size: 1.1rem;
            z-index: 10;
        }

        .form-control-custom {
            width: 100%;
            padding: 0.875rem 1rem 0.875rem 3rem;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background-color: #fff;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--color-carmesi);
            box-shadow: 0 0 0 3px var(--color-carmesi-light);
        }

        .form-control-custom::placeholder {
            color: #adb5bd;
        }

        .btn-login {
            width: 100%;
            padding: 1rem;
            background-color: var(--color-carmesi);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

        .btn-login:hover {
            background-color: var(--color-carmesi-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(220, 20, 60, 0.3);
        }

        .alert-danger {
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
            padding: 0.875rem 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
        }

        .text-danger {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 0.25rem;
            display: block;
        }

        @@media (max-width: 992px) {
            .login-container { flex-direction: column; }
            .branding-column, .form-column {
                flex: 0 0 100%;
                min-height: 50vh;
            }
            .branding-column { padding: 3rem 2rem; }
            .form-column { padding: 3rem 2rem; }
            .brand-name { font-size: 2rem; }
            .logo-icon { width: 100px; height: 100px; }
            .logo-icon i { font-size: 50px; }
        }

        @@media (max-width: 576px) {
            .brand-name { font-size: 1.75rem; }
            .brand-subtitle { font-size: 0.8rem; }
            .form-title { font-size: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Columna Izquierda: Branding -->
        <div class="branding-column">
            <div class="logo-container">
                <div class="logo-icon">
                    <i class="bi bi-plus-lg"></i>
                </div>
                <h1 class="brand-name">HOSPI-VITAL</h1>
                <div class="brand-separator"></div>
                <p class="brand-subtitle">SISTEMA DE GESTION<br>BANCO DE SANGRE</p>
            </div>
        </div>

        <!-- Columna Derecha: Formulario -->
        <div class="form-column">
            <div class="form-container">
                <h2 class="form-title">Bienvenido de nuevo</h2>
                <p class="form-subtitle">Por favor, ingrese sus credenciales para acceder al sistema</p>

                <form asp-controller="Home" asp-action="Index" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert-danger">
                            @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                            {
                                <span>@error.ErrorMessage</span>
                            }
                        </div>
                    }

                    <div class="form-group">
                        <label asp-for="Username" class="form-label">Nombre de Usuario</label>
                        <div class="input-group">
                            <i class="bi bi-person input-icon"></i>
                            <input asp-for="Username" class="form-control-custom" placeholder="Ej: justin.romero" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <div class="input-group">
                            <i class="bi bi-lock input-icon"></i>
                            <input asp-for="Password" class="form-control-custom" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-login">
                        INGRESAR
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
