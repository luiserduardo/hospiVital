<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospiVital_App</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospiVital_App.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">

        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        }

        <div class="bg-light vh-100 p-3" style="width: 250px;">

            <!-- LOGO -->
            <div class="text-center mb-4">
                <div class="bg-danger text-white rounded-circle d-inline-flex justify-content-center align-items-center"
                     style="width:60px;height:60px;">
                    <i class="bi bi-shield-plus fs-3"></i>
                </div>
                <h5 class="mt-2 text-danger fw-bold">HOSPI-VITAL</h5>
            </div>

            <!-- MENU -->
            <ul class="nav flex-column">

                <li class="nav-item mb-2">
                    <a class="nav-link @(currentController == "Home" ? "active text-white bg-danger rounded" : "text-dark")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house"></i> Inicio
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link @(currentController == "inventario" ? "active text-white bg-danger rounded" : "text-dark")"
                       asp-controller="inventario" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Inventario
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "receptores" ? "active text-white bg-danger rounded" : "text-dark")"
                       asp-controller="receptores" asp-action="Index">
                        <i class="bi bi-person-heart"></i> Receptores
                    </a>
                </li>

            </ul>
        </div>

        <div class="flex-grow-1">

            @RenderBody()

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
