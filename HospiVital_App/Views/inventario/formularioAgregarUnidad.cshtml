@model HospiVital_App.Models.unidadDeSangre

@{
    ViewData["Title"] = "Agregar unidad";
}


<form asp-action="agregarUnidad" method="post">
    <div class="modal-body">
        
        <h1>REGISTRO DE NUEVO DONANTE</h1>

        <div class="mb-3">
            <label>ID DONACION</label>
            <input name="idUnidad" type="text" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Tipo de Sangre</label>
            <select name="tipoSangre" class="form-select">
                <option value="" selected disabled>Seleccione un tipo...</option>
                <option value="A">Tipo A</option>
                <option value="B">Tipo B</option>
                <option value="AB">Tipo AB</option>
                <option value="O">Tipo O</option>
            </select>
        </div>

        <div class="mb-3">
    <label class="form-label">Factor RH</label>
    <select name="factorRh" class="form-select">
        <option value="+">+</option>
        <option value="-">-</option>
    </select>
        </div>

        <div class="form-group mb-3">
            <label class="control-label">Fecha de Ingreso</label>
            <input name="fechaIngreso" type="datetime-local" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label class="control-label">Fecha de Caducidad</label>
            <input name="fechaCaducidad" type="datetime-local" class="form-control" />
        </div>

        <div class="mb-3">
            <label>ESTADO</label>
            <input name="estadoUnidad" type="text" class="form-control" required />
        </div>


        <div class="mb-3">
            <label>CANTIDAD</label>
            <input name="cantidad" type="text" class="form-control" required />
        </div>


        @* informacion para ser excluyente *@


      
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    </div>
    </div>
    
</form>