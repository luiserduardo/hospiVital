@model HospiVital_App.Models.unidadDeSangre

@{
    ViewData["Title"] = "Agregar unidad";
}

<form id="formularioAgregarUnidad" asp-action="agregarUnidad" method="post">

    <div class="inventario-modal-body">

        <!-- ID -->
                   <div class="inventario-form-grid">


              <div class="inventario-field ">

                <label>ID DONACION</label>
                <input class="form-noActivo" id="idUnidad" name="idUnidad" type="text" readonly />
            </div>

            <div class="inventario-field">
                <label>ESTADO DEL VIAL</label>
                <select name="estadoUnidad" class="inventario-select form-noActivo" readonly>
                    <option value="Disponible">Disponible</option>
                </select>
            </div>

            <div class="inventario-field">
                <label>Cantidad</label>
                <input class="form-noActivo" name="cantidad" value="1" type="text" readonly />
            </div>

        </div>

        <!-- GRID PRINCIPAL -->
        <div class="inventario-form-grid">

            <div class="inventario-field">
                <label>TIPO DE SANGRE</label>
                <select name="tipoSangre" class="inventario-select">
                    <option value="" selected disabled>Seleccione un tipo...</option>
                    <option value="A">Tipo A</option>
                    <option value="B">Tipo B</option>
                    <option value="AB">Tipo AB</option>
                    <option value="O">Tipo O</option>
                </select>
            </div>

            <div class="inventario-field">
                <label>FACTOR RH</label>
                <select name="factorRh" class="inventario-select">
                    <option value="+">+</option>
                    <option value="-">-</option>
                </select>
            </div>

        </div>

        <!-- FECHAS -->
        <div class="inventario-form-grid">

            <div class="inventario-field">
                <label>FECHA DE INGRESO</label>
                <input name="fechaIngreso" type="date" />
            </div>

            <div class="inventario-field">
                <label>Fecha de Caducidad</label>
                <input name="fechaCaducidad" type="date" />
            </div>

        </div>



        <!-- PERSONAL -->
        <div class="inventario-form-section">
            <h4>INFORMACIÓN PERSONAL</h4>

          
            <div class="inventario-form-grid ">

                 <div class="inventario-field">
                <label>DUI</label>
                <input name="dui" type="text" placeholder="00000000-0" />
            </div>


                <div class="inventario-field">
                    <label>NOMBRE</label>
                    <input name="nombre" type="text" placeholder="Luis Eduardo"/>
                </div>

                <div class="inventario-field">
                    <label>APELLIDO</label>
                    <input name="apellido" type="text" placeholder="Lopez Orantes" />
                </div>

            </div>


            <div class="inventario-form-grid ">

            <div class="inventario-field">
                <label>TELÉFONO</label>
                <input name="telefono" type="text"  placeholder="0000-0000"/>
            </div>

            <div class="inventario-field">
                <label>PESO (KG)</label>
                <input name="peso" type="text" placeholder="50 kg" />
            </div>
        </div>

                    </div>


        <!-- CUESTIONARIO -->
        <div class="inventario-form-section">
            <h4>CUESTIONARIO DE ELEGIBILIDAD</h4>

            <div class="eligibility-grid">

                <div class="eligibility-item">
                    <span>¿Ha desayunado hoy?</span>
                    <div class="toggle-group" data-target="haDesayunado">
                        <button type="button" class="toggle-option active" data-value="true">Sí</button>
                        <button type="button" class="toggle-option" data-value="false">No</button>
                    </div>
                </div>

                <div class="eligibility-item">
                    <span>¿Durmió al menos 6 horas?</span>
                    <div class="toggle-group" data-target="haDormido">
                        <button type="button" class="toggle-option active" data-value="true">Sí</button>
                        <button type="button" class="toggle-option" data-value="false">No</button>
                    </div>
                </div>

                <div class="eligibility-item">
                    <span>¿Tatuajes últimos 12 meses?</span>
                    <div class="toggle-group danger-group" data-target="realizadoTratuajes">
                        <button type="button" class="toggle-option active" data-value="true">Sí</button>
                        <button type="button" class="toggle-option" data-value="false">No</button>
                    </div>
                </div>

                <div class="eligibility-item">
                    <span>¿Ha consumido alcohol 48h?</span>
                    <div class="toggle-group danger-group" data-target="haConsumido">
                        <button type="button" class="toggle-option active" data-value="true">Sí</button>
                        <button type="button" class="toggle-option" data-value="false">No</button>
                    </div>
                </div>

            </div>

            <input type="hidden" name="haDesayunado" id="haDesayunado" value="true" />
            <input type="hidden" name="haDormido" id="haDormido" value="true" />
            <input type="hidden" name="realizadoTratuajes" id="realizadoTratuajes" value="true" />
            <input type="hidden" name="haConsumido" id="haConsumido" value="true" />
        </div>

        <!-- ENFERMEDADES, EXCLUYENTES, si las tienen no donan-->
        <div class="inventario-form-section">
            <h4>ANTECEDENTES Y EXCLUSIÓN</h4>

            <div class="inventario-field full">
                <label>Tiene alguna enfermedad cronica?</label>
                <select name="enfermedades" class="inventario-select">
                    <option value="Nada">No posee enfermedad</option>
                    <option value="hepatitis">Hepatitis</option>
                    <option value="SIDA">SIDA</option>
                    <option value="Anemia">Anemia</option>
                    <option value="Sifiles">Sifiles</option>
                    <option value="Priones">infecciones por priones.</option>
                </select>
            </div>

        </div>

        <div class="inventario-modal-footer">
            <button type="button" id="btnCancelarDonacion" class="btn-outline-custom">
                Cancelar
            </button>

            <button type="submit" class="add-btn">
                Guardar Cambios
            </button>
        </div>

    </div>

</form>