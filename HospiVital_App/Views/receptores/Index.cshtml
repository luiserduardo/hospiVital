@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Receptores";
}

<div class="container-fluid mt-4">

    <div class="card shadow-sm mb-4 border-0">
        <div class="bg-white border-bottom w-100 px-4 py-3 d-flex justify-content-between align-items-center"
             style="margin-top: -24px;">

            <h4 class="mb-0 fw-semibold">Registro de receptores</h4>

            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-danger">
                    <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                </button>

                <div class="bg-light rounded-circle d-flex justify-content-center align-items-center"
                     style="width:40px; height:40px;">
                    <i class="bi bi-person-fill"></i>
                </div>
            </div>

        </div>
    </div>

    <!-- CARDS -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm p-3 d-flex flex-row justify-content-between align-items-center">
                <div>
                    <small>Total Receptores</small>
                    <h3>1,284</h3>
                </div>
                <div class="bg-danger bg-opacity-10 p-3 rounded">
                    <i class="bi bi-people-fill text-danger fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm p-3 d-flex flex-row justify-content-between align-items-center border-start border-success border-4">
                <div>
                    <small>Completados Hoy</small>
                    <h3 class="text-success">14</h3>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded">
                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- TABLA -->
    <div class="card p-3 mb-3 shadow-sm">
        <div class="d-flex justify-content-between align-items-center flex-nowrap gap-2 mb-3">

            <div class="position-relative" style="min-width: 250px;">
                <i class="bi bi-search position-absolute" style="left: 10px; top: 10px; color: gray;"></i>
                <input type="text" class="form-control ps-5" placeholder="ID o nombre del paciente" />
            </div>

            <div class="d-flex flex-nowrap gap-2">
                <button class="btn btn-outline-secondary">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>

                <button class="btn btn-danger text-nowrap">
                    <i class="bi bi-plus-circle"></i> Agregar nuevo donativo
                </button>
            </div>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID RECEPTOR</th>
                        <th>BENEDICIARIO</th>
                        <th>TIPO SANGRE</th>
                        <th>DONANTE</th>
                        <th>UNIDAD</th>
                        <th>FECHA</th>
                        <th>ACCIONES</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdReceptor</td>
                            <td>@item.Beneficiario</td>

                            <td>
                                <span class="badge bg-primary">
                                    @item.TipoSangre
                                </span>
                            </td>

                            <td>@item.Donante</td>

                            <td class="text-danger fw-bold">
                                @item.UnidadAsignada
                            </td>

                            <td>@item.FechaTransfusion</td>

                            <td>⋮</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

            <!-- FOOTER -->
            <div class="d-flex justify-content-between p-3">
                <span>Mostrando 1-4 de 128</span>
                <div>
                    <button class="btn btn-light btn-sm">Anterior</button>
                    <button class="btn btn-light btn-sm">Siguiente</button>
                </div>
            </div>

    </div>


</div>

<style>
    .badge {
        padding: 6px 10px;
        border-radius: 10px;
        font-weight: 500;
    }

    .card {
        border-radius: 12px;
    }

    table th {
        font-size: 12px;
        color: gray;
    }
</style>