@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Registro de Beneficiarios";
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/receptores.css" asp-append-version="true" />
<div class="container-fluid mt-4">
    
    <!-- CARDS -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm p-3 d-flex flex-row justify-content-between align-items-center">
                <div>
                    <small>Total Receptores</small>
                    <h3>@ViewBag.TotalPacientes</h3>
                </div>
                <div class="bg-danger bg-opacity-10 p-3 rounded">
                    <i class="bi bi-people-fill text-danger fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm p-3 d-flex flex-row justify-content-between align-items-center border-start border-success border-4">
                <div>
                    <small>Completados Hoy</small>
                    <h3 class="text-success">@ViewBag.CompletadosHoy</h3>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded">
                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                </div>
            </div>
        </div>

    </div>

    @await Html.PartialAsync("FormularioAgregarDonativo")

    <!-- TABLA -->
    <div class="card p-3 mb-3 shadow-sm">
        <div class="d-flex justify-content-between align-items-center flex-nowrap gap-2 mb-3">

            <div class="position-relative" style="min-width: 250px;">
                <i class="bi bi-search position-absolute" style="left: 10px; top: 10px; color: gray;"></i>
                <input id="buscador" type="text" class="form-control ps-5" placeholder="ID o nombre del paciente" />
            </div>

            <div class="d-flex flex-nowrap gap-2">

                <div class="dropdown">
                    <button class="btn btn-filtro dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-funnel me-2"></i> Filtrar
                    </button>

                    <ul class="dropdown-menu p-2 shadow-sm">
                        <li><a class="dropdown-item filtro-item" data-tipo="">Todos</a></li>
                        <li><a class="dropdown-item filtro-item" data-tipo="A+">A+</a></li>
                        <li><a class="dropdown-item filtro-item" data-tipo="A-">A-</a></li>
                        <li><a class="dropdown-item filtro-item" data-tipo="B+">B+</a></li>
                        <li><a class="dropdown-item filtro-item" data-tipo="B-">B-</a></li>
                        <li><a class="dropdown-item filtro-item" data-tipo="AB+">AB+</a></li>
                        <li><a class="dropdown-item filtro-item" data-tipo="AB-">AB-</a></li>
                        <li><a class="dropdown-item filtro-item" data-tipo="O+">O+</a></li>
                        <li><a class="dropdown-item filtro-item" data-tipo="O-">O-</a></li>
                    </ul>
                </div>

                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalReceptor">
                    + Agregar nuevo donativo
                </button>
            </div>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table id="tablaReceptores" class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID RECEPTOR</th>
                        <th>BENEFICIARIO</th>
                        <th>TIPO SANGRE</th>
                        <th>DONANTE</th>
                        <th>UNIDAD</th>
                        <th>FECHA</th>
                        <th>ACCIONES</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-id="@item.IdReceptor"
                            data-nombre="@item.Beneficiario.ToLower()"
                            data-tipo="@item.TipoSangre">

                            <td>@item.IdReceptor</td>
                            <td>@item.Beneficiario</td>

                            <td>
                                @{
                                    var tipoCompleto = item.TipoSangre;
                                    var tipo = tipoCompleto.Substring(0, tipoCompleto.Length - 1);
                                    var rh = tipoCompleto.Substring(tipoCompleto.Length - 1);

                                    var claseTipo = "sangre-" + tipo;
                                    var claseRh = rh == "+" ? "rh-pos" : "rh-neg";
                                }

                                <span class="badge-sangre @claseTipo @claseRh">
                                    @tipoCompleto
                                </span>
                            </td>

                            <td>@item.Donante</td>

                            <td class="text-danger fw-bold">
                                @item.UnidadAsignada
                            </td>

                            <td>@item.FechaTransfusion</td>

                            <td>⋮</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

            <!-- FOOTER -->
        <div class="d-flex justify-content-between p-3">
            @{
                //Calculamos cuantos elementos tiene la tabla
                var mostrados = Model.Count();
                var total = ViewBag.TotalPacientes ?? 0;
            }

            <span>
                Mostrando 1-@mostrados de @total
            </span>
    
            <div>
                <button class="btn btn-light btn-sm" @(mostrados == 0 ? "disabled" : "")>Anterior</button>
                <button class="btn btn-light btn-sm" @(mostrados == 0 ? "disabled" : "")>Siguiente</button>
            </div>
        </div>

    </div>


</div>

<style>
    .badge {
        padding: 6px 10px;
        border-radius: 10px;
        font-weight: 500;
    }

    .card {
        border-radius: 12px;
    }

    table th {
        font-size: 12px;
        color: gray;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/receptores.js"></script>